    "startupCheck": "./AurisStartupCheck.qml",
    "icon": "headphones",
    "requires_dms": ">=0.1.0",
    "dependencies": [
        "aurisd"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
